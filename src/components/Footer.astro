---
const year = new Date().getFullYear();
---

<footer class="site-footer" data-overscroll-theme="#1a1a1a">
  <div class="site-footer-line-wrap container" aria-hidden="true"><div class="site-footer-line"></div></div>
  <div class="site-footer-inner container">
    <div class="site-footer-block site-footer-block--identity">
      <span>Franck Chabin</span>
      <span>Graphiste et directeur artistique</span>
    </div>

    <div class="site-footer-block site-footer-block--meta">
      <span>Paris, France — &copy;{year}</span>
      <a href="mailto:franck.chabin@icloud.com">franck.chabin@icloud.com</a>
    </div>

    <!-- Bonhomme "chill" N&B à la place du contact (même logique responsive : à droite) -->
    <div class="site-footer-block site-footer-block--contact">
      <div id="footer-dance" class="footer-dance" aria-hidden="true"></div>
    </div>
  </div>
  <div class="site-footer-legal container">
    <span>&copy;franckchabin{year} Tous droits réservés</span>
  </div>
</footer>

<script>
  import { initCornerDance } from '../scripts/cornerDance';
  const mount = document.getElementById('footer-dance');
  if (mount) {
    const glbV = import.meta.env.DEV ? Date.now() : '4';
    const start = () => initCornerDance(mount, `/3Dboy/perso_rigge.glb?v=${glbV}`, {
      pixelSize: 2,           // légère pixelisation
      chill: true,            // idle seulement, aucune interaction
      grayscale: true,        // noir & blanc
      outlineColor: '#ffffff',// contour blanc détaché au survol (hover)
      params: { sizeMul: 0.95, facingY: 0, ambient: 1.8, fresnel: 0 },
    });
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 300);
  }
</script>

<style>
  .site-footer {
    background-color: var(--color-text);
    color: var(--color-bg);
    padding-top: var(--space-xl);
  }

  .site-footer-line-wrap {
    padding: 0 var(--gutter);
  }

  /* Bloc qui contient le bonhomme : pleine opacité (sinon le canvas est estompé) */
  .site-footer-block.site-footer-block--contact {
    opacity: 1;
  }
  .footer-dance {
    width: 150px;
    height: 210px;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .footer-dance { width: 190px; height: 260px; }
  }

  .site-footer-line {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: var(--space-xl);
  }

  .site-footer-inner {
  }

  .site-footer-block {
    display: flex;
    flex-direction: column;
    font-family: var(--font-nav);
    color: var(--color-bg);
    opacity: 0.2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.35;
  }

  .site-footer-block a {
    color: inherit;
    width: fit-content;
  }

  @media (hover: hover) {
    .site-footer-block a {
      transition: opacity var(--transition-fast);
    }
    .site-footer-block a:hover {
      opacity: 1;
    }
  }

  /* =============================================
     MOBILE — tout centré, empilé proprement
     ============================================= */
  .site-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
    padding: 0 var(--gutter) var(--space-lg);
  }

  .site-footer-block {
    align-items: center;
    gap: 0.15em;
    font-size: clamp(0.7rem, 2.8vw, 0.85rem);
  }

  .site-footer-legal {
    font-family: var(--font-nav);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bg);
    opacity: 0.2;
    font-size: clamp(0.7rem, 2.8vw, 0.85rem);
    text-align: center;
    padding: var(--space-lg) var(--gutter) var(--space-lg);
  }

  /* =============================================
     DESKTOP — 3 colonnes classiques
     ============================================= */
  @media (min-width: 768px) {
    .site-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: start;
      text-align: left;
      gap: var(--space-xl);
    }

    .site-footer-block {
      flex: 1 1 0;
      white-space: nowrap;
      font-size: clamp(0.75rem, 1.25vw, 1.15rem);
      line-height: 1.1;
      gap: var(--space-xs);
    }

    .site-footer-block--identity {
      align-items: flex-start;
    }

    .site-footer-block--meta {
      align-items: center;
    }

    .site-footer-block--contact {
      align-items: flex-end;
      text-align: right;
    }

    .site-footer-legal {
      text-align: left;
      font-size: clamp(0.75rem, 1.25vw, 1.15rem);
    }
  }
</style>
